{
  "name": "creative-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Premium creative studio and digital agency website",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/server.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/server.js",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^12.6.3",
    "gsap": "^3.12.7",
    "lenis": "^1.2.3",
    "lucide-react": "^0.487.0",
    "mongodb": "^6.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.4",
    "vite": "^6.3.2"
  }
}
